let
    var aplicarDuasVezes = fn operacao x . operacao(operacao(x)),
    
    var dobrar = fn x . x * 2
in
    describe("Teste 2",
        
        test("1. Caminho Feliz (Alta Ordem em Acao)", 
             expect(aplicarDuasVezes(dobrar, 5), 20)
        ),
        
        test("2. Isolamento de Falha Profunda (Funcao Corrompida)", 
             toThrow(expect(aplicarDuasVezes(dobrar, 5), 2))
        ),
        
        test("3. Recuperacao e Continuidade do Interpretador", 
             expect(aplicarDuasVezes(dobrar, 10), 40)
        )
    )