let
    var sacar = fn saldo valor . if saldo > valor then saldo - valor else saldo
in
    describe("Suite de Auditoria de Saques",
        
        test("1. Saque dentro do limite", 
             expect(sacar(100, 20), 80)
        ),
        
        test("2. Falha critica de memoria", 
             toThrow(sacar(100, valorCorrompido))
        ),
        
        test("3. Garantindo a continuidade", 
             expect(sacar(200, 50), 150)
        )
    )